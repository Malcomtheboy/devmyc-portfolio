# Copy to .env.local for local testing. Real values go in Vercel:
# Project → Settings → Environment Variables. Never commit real keys.

# API key from https://resend.com/api-keys (starts with re_)
RESEND_API_KEY=

# Where contact form messages are delivered
CONTACT_TO_EMAIL=

# Optional sender. Leave empty to use Resend's test sender, which can only
# deliver to the email address of your own Resend account.
CONTACT_FROM=
